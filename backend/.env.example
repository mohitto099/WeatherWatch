# Copy to ".env" in this folder and fill in. NEVER commit the real ".env".

# Same Supabase connection string you used for the pipeline (Session pooler URI)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Airflow (docker compose defaults)
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_DAG_ID=weather_watch_dag

# A stored record newer than this is served from the cache instead of re-running the pipeline
CACHE_MINUTES=15
