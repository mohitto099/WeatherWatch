# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file - it's already in .gitignore.

# Supabase PostgreSQL connection string
# Found in: Supabase project -> Settings -> Database -> Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Open-Meteo needs no API key - kept here only for forward-compatibility
# in case you later switch to a provider that does (e.g. OpenWeatherMap).
WEATHER_API_KEY=
